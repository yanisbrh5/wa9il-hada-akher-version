{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseSettings": {
    "RotationStrategy": "SizeBased",
    "MaxDatabaseSizeMB": 500,
    "CurrentDatabase": "Database1",
    "NotifyOnRotation": true
  },
  "CleanupSettings": {
    "Enabled": true,
    "IntervalHours": 120,
    "RetentionDays": 5,
    "NotifyOnCleanup": true
  }
}



